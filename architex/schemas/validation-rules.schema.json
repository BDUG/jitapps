{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architex.local/schemas/validation-rules.schema.json",
  "title": "Validation rule library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "defaultRuleEnabled",
    "rules"
  ],
  "properties": {
    "format": {
      "const": "architex-validation-rules"
    },
    "version": {
      "const": 1
    },
    "defaultRuleEnabled": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "source": {
            "type": "string",
            "maxLength": 50000
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
