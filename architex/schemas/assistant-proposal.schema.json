{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architex.local/schemas/assistant-proposal.schema.json",
  "title": "Spec-driven architecture edit proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "summary",
    "specification"
  ],
  "anyOf": [
    {
      "required": [
        "metamodel"
      ]
    },
    {
      "required": [
        "instanceModel"
      ]
    },
    {
      "required": [
        "ruleLibrary"
      ]
    }
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "requirements",
        "acceptanceCriteria",
        "implementationPlan",
        "validationPlan",
        "assumptions"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "implementationPlan": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "validationPlan": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metamodel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "dependencies"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "category",
              "description",
              "parentId",
              "x",
              "y",
              "parameters",
              "ports",
              "color"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "parentId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "description",
                    "allowedComponentIds",
                    "exposedToParent",
                    "direction"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "allowedComponentIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "exposedToParent": {
                      "type": "boolean",
                      "default": true
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "in",
                        "out"
                      ]
                    }
                  }
                }
              },
              "subgroupPosition": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "description": "Optional child position relative to its parent container. Omit for automatic packing."
              },
              "icon": {
                "type": "string",
                "maxLength": 32767,
                "pattern": "^data:image/png;base64,[A-Za-z0-9+/]+={0,2}$",
                "description": "Optional embedded PNG icon, normalized to at most 96 by 96 pixels on upload."
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "instanceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances",
        "connections"
      ],
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "componentId",
              "name",
              "x",
              "y",
              "parameters",
              "ports"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "description",
                    "definitionId",
                    "direction"
                  ],
                  "properties": {
                    "direction": {
                      "type": "string",
                      "enum": [
                        "in",
                        "out"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "definitionId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instanceId",
                  "portId"
                ],
                "properties": {
                  "instanceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "portId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instanceId",
                  "portId"
                ],
                "properties": {
                  "instanceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "portId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "ruleLibrary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://architex.local/schemas/validation-rules.schema.json",
      "title": "Validation rule library",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "defaultRuleEnabled",
        "rules"
      ],
      "properties": {
        "format": {
          "const": "architex-validation-rules"
        },
        "version": {
          "const": 1
        },
        "defaultRuleEnabled": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "source",
              "enabled"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "source": {
                "type": "string",
                "maxLength": 50000
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
