{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architex.local/schemas/workspace.schema.json",
  "title": "Architex workspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "components",
    "dependencies",
    "instances",
    "connections"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "description",
          "parentId",
          "x",
          "y",
          "parameters",
          "ports",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "description",
                "allowedComponentIds",
                "exposedToParent",
                "direction"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "allowedComponentIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "exposedToParent": {
                  "type": "boolean",
                  "default": true
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "in",
                    "out"
                  ]
                }
              }
            }
          },
          "subgroupPosition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "description": "Optional child position relative to its parent container. Omit for automatic packing."
          },
          "icon": {
            "type": "string",
            "maxLength": 32767,
            "pattern": "^data:image/png;base64,[A-Za-z0-9+/]+={0,2}$",
            "description": "Optional embedded PNG icon, normalized to at most 96 by 96 pixels on upload."
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentId",
          "name",
          "x",
          "y",
          "parameters",
          "ports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "description",
                "definitionId",
                "direction"
              ],
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "definitionId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "portId"
            ],
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1
              },
              "portId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "portId"
            ],
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1
              },
              "portId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "portModelVersion": {
      "const": 2
    },
    "modelType": {
      "type": "string",
      "enum": [
        "metamodel",
        "instances"
      ]
    },
    "sphinx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metamodel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "bindings"
          ],
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "encoding",
                  "content"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "encoding": {
                    "type": "string",
                    "enum": [
                      "utf8",
                      "base64"
                    ]
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "needId",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "metamodel",
                      "instances"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "needId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "instances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "bindings"
          ],
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "encoding",
                  "content"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "encoding": {
                    "type": "string",
                    "enum": [
                      "utf8",
                      "base64"
                    ]
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "needId",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "metamodel",
                      "instances"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "needId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "modelType"
        ],
        "properties": {
          "modelType": {
            "const": "metamodel"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "instances": {
            "type": "array",
            "maxItems": 0
          },
          "connections": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "modelType"
        ],
        "properties": {
          "modelType": {
            "const": "instances"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "components": {
            "type": "array",
            "maxItems": 0
          },
          "dependencies": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
