{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architex.local/schemas/component-port.schema.json",
  "title": "Metamodel port connection policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "allowedComponentIds",
    "exposedToParent",
    "direction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "allowedComponentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exposedToParent": {
      "type": "boolean",
      "default": true
    },
    "direction": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ]
    }
  }
}
