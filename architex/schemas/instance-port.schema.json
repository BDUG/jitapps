{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architex.local/schemas/instance-port.schema.json",
  "title": "Instance data-point port",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "definitionId",
    "direction"
  ],
  "properties": {
    "direction": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "definitionId": {
      "type": "string",
      "minLength": 1
    }
  }
}
