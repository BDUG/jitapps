{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TLAL OS",
  "version": "0.1.0",
  "identifier": "com.bdug.tlalos",
  "build": {
    "frontendDist": "../launcher",
    "beforeDevCommand": "npm run prepare:desktop",
    "beforeBuildCommand": "npm run prepare:desktop"
  },
  "app": {
    "windows": [{"label":"main","title":"TLAL OS","url":"index.html","width":1440,"height":960,"minWidth":800,"minHeight":600}],
    "security": {"capabilities": [], "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'"}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/suite-server"],
    "resources": {"resources/suite/": "suite/"},
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.ico","icons/icon.icns"],
    "shortDescription": "Local-first agentic desktop tool suite",
    "license": "MIT"
  }
}
