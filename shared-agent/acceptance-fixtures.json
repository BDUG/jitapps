  {
    "name": "JSON pointer escaping",
    "rules": [
      {
        "id": "pointer",
        "title": "Pointer",
        "tool": "read_file",
        "checks": [
          {
            "path": "/a~1b/~0/0",
            "op": "equals",
            "value": false
          }
        ]
      }
    ],
    "events": [
      {
        "kind": "observation",
        "value": {
          "id": "p",
          "tool": "read_file",
          "ok": true,
          "result": {
            "a/b": {
              "~": [
                false
              ]
            }
          }
        }
      }
    ],
    "expected": [
      "passed"
    ]
  }
